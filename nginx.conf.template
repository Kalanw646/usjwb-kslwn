user www-data;
worker_processes 1;
pid /tmp/nginx.pid;
error_log /tmp/nginx-error.log warn;
events { worker_connections 1024; }
http {
  access_log /tmp/nginx-access.log;
  map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
  }
  server {
    listen __PORT__;
    client_max_body_size 10m;
    # VLESS over WebSocket -> Xray core
    location /nexuz {
      proxy_pass http://127.0.0.1:10086;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      # Never buffer a live WebSocket stream: buffering stalls YouTube /
      # Telegram data (handshake/ping works, real data never arrives).
      proxy_buffering off;
      proxy_request_buffering off;
      tcp_nodelay on;
      proxy_socket_keepalive on;
      proxy_read_timeout 86400s;
      proxy_send_timeout 86400s;
    }
    # Everything else -> Flask panel
    location / {
      proxy_pass http://127.0.0.1:5000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $fwd_proto;
      proxy_set_header X-Forwarded-Host $host;
    }
  }
}
